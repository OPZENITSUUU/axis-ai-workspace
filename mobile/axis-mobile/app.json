{
  "expo": {
    "name": "AXIS",
    "slug": "axis-mobile",
    "version": "0.4.0",
    "orientation": "portrait",
    "scheme": "axis",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "space.manus.axis.mobile",
      "edgeToEdgeEnabled": true,
      "versionCode": 4,
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "axis-tasks",
          "color": "#85dfb9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b1ee2df9-96a8-4d00-b59d-6dde1b3adc66"
      }
    },
    "owner": "opzenitsu",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b1ee2df9-96a8-4d00-b59d-6dde1b3adc66",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {}
  }
}
